local function createWallVisual(raycastResult)
    if not WallVisualsEnabled then return end
    
    local part = raycastResult.Instance
    local position = raycastResult.Position
    local normal = raycastResult.Normal
    
     创建墙体可视化
    local wallFrame = Instance.new("Part")
    wallFrame.Name = "WallVisual"
    wallFrame.Size = Vector3.new(2, 2, 0.1)
    wallFrame.Position = position + normal * 0.05
    wallFrame.CFrame = CFrame.lookAt(wallFrame.Position, wallFrame.Position + normal)
    wallFrame.Anchored = true
    wallFrame.CanCollide = false
    wallFrame.Material = Enum.Material.Neon
    wallFrame.Transparency = 0.3
    wallFrame.Color = Color3.new(1, 1, 1)  白色
    wallFrame.Parent = Workspace
    
     创建边框
    local border = Instance.new("SelectionBox")
    border.Adornee = wallFrame
    border.LineThickness = 0.02
    border.Color3 = Color3.new(1, 1, 1)
    border.Parent = wallFrame
    
    table.insert(WallVisuals, wallFrame)
    
     10秒后自动清理
    delay(10, function()
        if wallFrame and wallFrame.Parent then
            wallFrame:Destroy()
        end
    end)
end

local function clearWallVisuals()
    for _, wall in ipairs(WallVisuals) do
        if wall and wall.Parent then
            wall:Destroy()
        end
    end
    WallVisuals = {}
end

