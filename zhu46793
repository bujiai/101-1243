local function modifyNPCsAndMonsters()
    local npcCount = 0
    
    for _, object in ipairs(Workspace:GetDescendants()) do
        if object:IsA("Model") then
            local humanoid = object:FindFirstChildOfClass("Humanoid")
            local isPlayer = false
            
             检查是否是玩家角色
            for _, player in ipairs(Players:GetPlayers()) do
                if player.Character == object then
                    isPlayer = true
                    break
                end
            end
            
            if humanoid and not isPlayer and object ~= lp.Character then
                 检查距离
                if isInRange(object) then
                     修改每个部件
                    for _, partName in ipairs(HitboxModifier.PartsToModify) do
                        local part = object:FindFirstChild(partName)
                        if part and part:IsA("BasePart") then
                            part.Size = Vector3.new(HitboxModifier.HitboxSize, HitboxModifier.HitboxSize, HitboxModifier.HitboxSize)
                            part.Transparency = 0.8
                            part.Color = Color3.new(1, 1, 1)  白色
                            part.Material = Enum.Material.Neon
                            part.CanCollide = false
                        end
                    end
                    
                    npcCount = npcCount + 1
                end
            end
        end
    end
    
    return npcCount
end

