        createNewPlayerHighlight(player)
    end
    
     
    player.CharacterAdded:Connect(function(newChar)
        wait(1)  等待角色加载
        if ESPHandles[player] then
            ESPHandles[player]:Destroy()
        end
        if PlayerNameTags[player] then
