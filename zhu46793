 修复的颜色过渡函数
local function updateColorTransition(deltaTime)
    transitionProgress = transitionProgress + (deltaTime / colorTransitionTime)
    
    if transitionProgress >= 1 then
        transitionProgress = 0
        currentColorIndex = nextColorIndex
        nextColorIndex = nextColorIndex + 1
        if nextColorIndex > #colors then
            nextColorIndex = 1
        end
    end
    
     计算当前过渡颜色
    local currentColor = colors[currentColorIndex]
    local nextColor = colors[nextColorIndex]
    local lerpedColor = currentColor:Lerp(nextColor, transitionProgress)
    
     更新屏幕文字颜色
    screenText.TextColor3 = lerpedColor
    
     更新所有显示的文本颜色
    for player, billboard in pairs(playerBillboards) do
        if billboard and billboard.Parent then
            local textLabel = billboard:FindFirstChild("PlayerNameTag")
            if textLabel then
                textLabel.TextColor3 = lerpedColor
            end
        else
             清理无效的billboard
            playerBillboards[player] = nil
        end
    end
end

