 优化的距离计算算法
local function calculateDistance(localPos, targetPos)
    return (localPos  targetPos).Magnitude
end

 优化的角度计算算法
local function calculateAngle(localChar, targetPos)
    local rootPart = localChar:FindFirstChild("HumanoidRootPart")
    if not rootPart then return 999 end
    
    local camera = Workspace.CurrentCamera
    local screenPoint, onScreen = camera:WorldToScreenPoint(targetPos)
    
    if not onScreen and not AimBot.Full360Aim then
        return 999
    end
    
    local viewportSize = camera.ViewportSize
    local center = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
    local screenPos = Vector2.new(screenPoint.X, screenPoint.Y)
    
    return (screenPos  center).Magnitude
end

 优化的目标选择算法
local function getOptimalTarget()
    local localPlayer = Players.LocalPlayer
    local localCharacter = localPlayer.Character
    if not localCharacter then return nil end
    
    local localRoot = localCharacter:FindFirstChild("HumanoidRootPart")
    if not localRoot then return nil end
    
    local camera = Workspace.CurrentCamera
    local bestTarget = nil
    local bestScore = 999999
    local localPos = localRoot.Position
    
     通用玩家查找算法
    for _, player in pairs(Players:GetPlayers()) do
        if player == localPlayer then continue end
        if isSameTeam(player) then continue end
        
        local character = player.Character
        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            
             存活检查
            if AimBot.AliveCheck then
                if not humanoid or humanoid.Health <= 0 then
                    continue
                end
            end
            
            if rootPart then
                local distance = calculateDistance(localPos, rootPart.Position)
                
                 距离检查
                if distance > AimBot.MaxDistance then
                    continue
                end
                
                 墙壁检查
                if AimBot.WallCheck then
                    local raycastParams = RaycastParams.new()
                    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
                    raycastParams.FilterDescendantsInstances = {localCharacter, character}
                    
                    local raycastResult = Workspace:Raycast(
                        camera.CFrame.Position,
                        (rootPart.Position  camera.CFrame.Position).Unit * distance,
                        raycastParams
                    )
                    
                    if raycastResult then
                        createWallVisual(raycastResult)
                        continue
                    end
                end
                
                 计算综合分数（距离 + 角度）
                local angleScore = calculateAngle(localCharacter, rootPart.Position)
                local distanceScore = distance
                
                 高级算法：综合评分
                local totalScore
                if AimBot.AdvancedAlgorithm then
                    totalScore = angleScore * 0.7 + distanceScore * 0.3
                else
                    totalScore = angleScore
                end
                
                if totalScore < bestScore and totalScore <= AimBot.FOV then
                    bestScore = totalScore
                    bestTarget = player
                end
            end
        end
    end
    
     备用算法
    if not bestTarget then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") then
                local humanoid = obj:FindFirstChildOfClass("Humanoid")
                local rootPart = obj:FindFirstChild("HumanoidRootPart")
                
                if humanoid and rootPart and obj ~= localCharacter then
                    local distance = calculateDistance(localPos, rootPart.Position)
                    
                    if distance <= AimBot.MaxDistance then
                        local angleScore = calculateAngle(localCharacter, rootPart.Position)
                        
                        if angleScore < bestScore and angleScore <= AimBot.FOV then
                            bestScore = angleScore
                            bestTarget = obj
                        end
                    end
                end
            end
        end
    end
    
    return bestTarget
end

 子弹预测算法
local function calculatePrediction(targetPos, targetVelocity, bulletSpeed)
    if not AimBot.BulletPrediction or bulletSpeed == math.huge then
        return targetPos
    end
    
    local localChar = Players.LocalPlayer.Character
    if not localChar then return targetPos end
    
    local localRoot = localChar:FindFirstChild("HumanoidRootPart")
    if not localRoot then return targetPos end
    
    local distance = (targetPos  localRoot.Position).Magnitude
    local travelTime = distance / bulletSpeed
    
     预测位置
    local predictedPos = targetPos + targetVelocity * travelTime * AimBot.PredictionStrength
    
    return predictedPos
end

 ==================== 优化的自瞄函数 ====================
local function smoothAimAtTarget(targetPosition, targetVelocity)
    local camera = Workspace.CurrentCamera
    local currentCFrame = camera.CFrame
    
     子弹预测
    if AimBot.BulletPrediction then
        targetPosition = calculatePrediction(targetPosition, targetVelocity, 1000)  假设子弹速度1000
    end
    
    local targetDirection = (targetPosition  currentCFrame.Position).Unit
    local targetCFrame = CFrame.lookAt(currentCFrame.Position, currentCFrame.Position + targetDirection)
    
    local smoothFactor = AimBot.SmoothAimSpeed * 0.5
    
     高级算法：防止向上飘
    if AimBot.AdvancedAlgorithm then
        local currentLookVector = currentCFrame.LookVector
        local targetLookVector = targetCFrame.LookVector
        
        local dotProduct = currentLookVector:Dot(targetLookVector)
        local angle = math.acos(math.clamp(dotProduct, 1, 1))
        
        local maxAngle = math.rad(5)
        if angle > maxAngle then
            local t = maxAngle / angle
            targetLookVector = currentLookVector:Lerp(targetLookVector, t)
            targetCFrame = CFrame.lookAt(currentCFrame.Position, currentCFrame.Position + targetLookVector)
        end
    end
    
    local newCFrame = currentCFrame:Lerp(targetCFrame, smoothFactor)
    
    local tweenInfo = TweenInfo.new(0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(camera, tweenInfo, {CFrame = newCFrame})
    tween:Play()
    
    return newCFrame
end

