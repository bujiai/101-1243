local function strongLockAimAtTarget(targetPosition, targetVelocity)
    local camera = Workspace.CurrentCamera
    
     子弹预测
    if AimBot.BulletPrediction then
        targetPosition = calculatePrediction(targetPosition, targetVelocity, 1000)
    end
    
    local targetDirection = (targetPosition  camera.CFrame.Position).Unit
    local targetCFrame = CFrame.lookAt(camera.CFrame.Position, camera.CFrame.Position + targetDirection)
    
     强锁模式直接设置相机位置
    camera.CFrame = targetCFrame
end

 优化的瞄准函数
local function aimAtTarget()
    if not AimBot.Enabled then return end
    
    local target = getOptimalTarget()
    if not target then
        AimBot.CurrentTarget = nil
        AimBot.LastAimPosition = nil
        return
    end
    
    local targetCharacter = target.Character or target
    if not targetCharacter then return end
    
    local targetPart = nil
    if AimBot.AimPart == "Head" then
        targetPart = targetCharacter:FindFirstChild("Head")
    else
        targetPart = targetCharacter:FindFirstChild("HumanoidRootPart")
    end
    
    if not targetPart then
        targetPart = targetCharacter:FindFirstChild("HumanoidRootPart")
        if not targetPart then return end
    end
    
    local localPlayer = Players.LocalPlayer
    local localCharacter = localPlayer.Character
    if not localCharacter then return end
    
    AimBot.CurrentTarget = target
    
    local targetPosition = targetPart.Position
    local targetVelocity = Vector3.new(0, 0, 0)
    
     获取目标速度用于预测
    local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
    if targetRoot then
        targetVelocity = targetRoot.Velocity
    end
    
     瞄准部位微调
    if AimBot.AimPart == "Head" then
        targetPosition = targetPosition + Vector3.new(0, 0.5, 0)
    else
        targetPosition = targetPosition + Vector3.new(0, 1, 0)
    end
    
     根据模式选择瞄准方式
    if AimBot.AimMode == "Smooth" then
        smoothAimAtTarget(targetPosition, targetVelocity)
    else  StrongLock
        strongLockAimAtTarget(targetPosition, targetVelocity)
    end
end

