local function updateWhitelist(whitelistText)
    HitboxModifier.WhitelistPlayers = {}
    for playerName in string.gmatch(whitelistText, "([^,]+)") do
        playerName = string.gsub(playerName, "^%s*(.)%s*$", "%1")
        if playerName ~= "" then
            HitboxModifier.WhitelistPlayers[playerName] = true
        end
    end
end

